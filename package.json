{
  "name": "sharetab",
  "version": "0.8.0",
  "description": "Private Cloudflare Workers expense tracker with receipt scanning",
  "author": "Carlos Cristobal",
  "license": "MIT",
  "homepage": "https://github.com/sw-carlos-cristobal/sharetab",
  "repository": {
    "type": "git",
    "url": "https://github.com/sw-carlos-cristobal/sharetab.git"
  },
  "keywords": [
    "cloudflare-workers",
    "splitwise-alternative",
    "expense-tracker",
    "receipt-scanner",
    "ai",
    "nextjs",
    "d1",
    "r2"
  ],
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "pnpm run build && pnpm run start",
    "build": "vinext build",
    "start": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pr:create": "node scripts/pr-create.mjs",
    "git:push-main": "node scripts/git-push-main.mjs",
    "push:main": "pnpm run git:push-main --",
    "db:types": "wrangler types",
    "db:migrate:local": "wrangler d1 migrations apply sharetab --local --config wrangler.jsonc --persist-to .wrangler/state",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:worker": "node scripts/smoke-worker.mjs",
    "lint:i18n": "tsx scripts/check-translations.ts",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json --persist-to .wrangler/state",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@prisma/adapter-d1": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tanstack/react-query": "^5.102.8",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@trpc/server": "^11.18.0",
    "@vinext/cloudflare": "^1.0.0-beta.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.45.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.4",
    "next-themes": "^0.4.6",
    "openai": "^6.33.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-server-dom-webpack": "^19.3.0",
    "sonner": "^2.0.8",
    "superjson": "^2.2.6",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vinext": "^1.0.0-beta.12",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.59.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "prisma": "^7.6.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^8.3.1",
    "vitest": "^4.1.2",
    "wrangler": "^4.138.0"
  },
  "type": "module"
}
